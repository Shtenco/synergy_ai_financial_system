# Polygon mainnet Scaled175 — copy locally to runtime/synergy_agent/local/polygon-scaled175.env
# Never commit a populated file. Never reuse a key that was pasted into chat.
NETWORK=polygon
CHAIN_ID=137
POLYGON_RPC_URL=
OWNER_PRIVATE_KEY=
EXPECTED_DEPLOYER_ADDRESS=

# Must refer to a newly created key that has never been shared.
KEY_ROTATED_ACK=I_CREATED_A_NEW_UNSHARED_KEY
EXECUTION_MODE=dry-run
MAINNET_ARM_PHRASE=DISABLED
FIRST10_ARM_PHRASE=DISABLED

# Execute mode remains rejected unless a separate gate explicitly allows deployment,
# proves robust positive first-ten growth, and records a passed refill regression.
MAINNET_GATE_REPORT=reports/bullish_quickswap_mainnet_stop_first10.json

# Contract-pinned trade sizing selected by exact Polygon fork validation:
# 2 buys of 0.175 USDT and 5 sells of approximately 0.07 USDT per cycle.
DEAL_SCALE_BPS=17500
BUY_USDT=0.175
SELL_NOTIONAL_USDT=0.07

# Supply these only after independently checking the official Polygon/QuickSwap deployment.
QUICKSWAP_V2_ROUTER=
POLYGON_USDT=
POLYGON_WPOL=

INIT_TOTAL_SUPPLY=1000000
INIT_POOL_SYNA=500000
INIT_POOL_USDT=1
INIT_ROBOT_USDT=1
MIN_DEPLOYER_POL=1
DEPLOY_CONFIRMATIONS=2
CYCLE_CONFIRMATIONS=2

KEEPER_POL_FLOOR=0.25
GAS_REFILL_POL=2
GAS_REFILL_SLIPPAGE_BPS=100
DEPLOYMENT_FILE=deployments/bullish_qs_scaled175_polygon.json
