# Polygon mainnet Synergy Shielded V5.
# Copy locally to runtime/synergy_agent/local/polygon-shielded-v5.env.
# Never commit a populated file. Never reuse a key that was pasted into chat.
NETWORK=polygon
CHAIN_ID=137

# Public RPC is allowed only for reads and pinned-fork diagnostics.
POLYGON_RPC_URL=
# Execution requires a distinct endpoint whose provider explicitly documents
# private/non-public transaction submission for Polygon PoS.
PRIVATE_POLYGON_RPC_URL=
PRIVATE_TX_ACK=DISABLED

OWNER_PRIVATE_KEY=
EXPECTED_DEPLOYER_ADDRESS=
KEY_ROTATED_ACK=I_CREATED_A_NEW_UNSHARED_KEY
EXECUTION_MODE=dry-run
MAINNET_ARM_PHRASE=DISABLED

MAINNET_GATE_REPORT=reports/synergy_shielded_v5_mainnet_gate.json
MIN_DEPLOYER_POL=3
MAX_DEPLOY_GAS_LIMIT=28000000
DEPLOY_CONFIRMATIONS=2

# Immutable fork-selected sizing inside BullishQuickSwapShieldedV5:
# 2 buys of 0.175 USDT and 5 sells of approximately 0.07 USDT per cycle.
DEAL_SCALE_BPS=17500
BUY_USDT=0.175
SELL_NOTIONAL_USDT=0.07

# Initial constructor-atomic launch values:
# 1 USDT QuickSwap liquidity + 1 USDT robot capital.
INIT_TOTAL_SUPPLY=1000000
INIT_POOL_SYNA=500000
INIT_POOL_USDT=1
INIT_ROBOT_USDT=1

# Runtime keeper settings.
KEEPER_POL_FLOOR=0.25
GAS_REFILL_POL=0.001
GAS_REFILL_SLIPPAGE_BPS=100
DEPLOYMENT_FILE=deployments/synergy_shielded_v5_polygon.json
