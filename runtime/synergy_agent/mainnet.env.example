# Polygon PoS mainnet — template only. Never commit a populated copy.
NETWORK=polygon
CHAIN_ID=137
RPC_URL=
PRIVATE_KEY=
EXPECTED_SIGNER_ADDRESS=

# Mainnet is disabled by default. Exact phrase is checked locally at runtime.
EXECUTION_MODE=dry-run
MAINNET_ARM_PHRASE=DISABLED
TX_SUBMISSION_MODE=private
PRIVATE_TX_ENDPOINT=

BLOCK_LIMIT=150
ACTION_INTERVAL=10
MAX_LOSS_POL=20
MIN_OWNER_POL=10
REFILL_POL=2
MAX_SINGLE_TX_GAS_POL=0.25
MAX_SINGLE_ACTION_NOTIONAL_POL=2
MAX_SLIPPAGE_BPS=50
MAX_PRICE_IMPACT_BPS=75
MAX_ORACLE_DEVIATION_BPS=75
MIN_CONFIRMATIONS=2
CHECKPOINT_PATH=runtime/synergy_agent/state/synergy_dqn.pt
SYNA_ADDRESS=
USDS_ADDRESS=
USDT_ADDRESS=
SYNA_USDS_POOL_ADDRESS=
SYNA_USDT_POOL_ADDRESS=
USDS_USDT_POOL_ADDRESS=
ROUTER_ADDRESS=
